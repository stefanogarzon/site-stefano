---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { page } from '../lib/content';
import { otherLang, routes } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const about = await page('about', lang);
const { Content } = await render(about);
---
<Base title={about.data.title} description={about.data.description} lang={lang} alternate={routes(otherLang(lang)).about} hasTranslation>
  <h1>{about.data.title}</h1>
  <img class="photo" src="/images/stefano.webp" alt="Stefano Garzon" width="1100" height="848" />
  <Content />
</Base>

<style>
  .photo { width: 100%; height: auto; border-radius: 10px; margin: 8px 0 24px; }
</style>
