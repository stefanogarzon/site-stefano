---
import { entryUrl, formatDate, t } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import type { CollectionEntry } from 'astro:content';

interface Props { items: (CollectionEntry<'reviews'> | CollectionEntry<'posts'>)[]; lang: Lang }
const { items, lang } = Astro.props;
const kindLabel = (e: Props['items'][number]) =>
  e.collection === 'reviews' ? t(lang, 'kind.reviews') : t(lang, `cat.${e.data.category}`);
---
<ul class="list">
  {items.map((e) => (
    <li>
      <span class:list={['eyebrow', { accent: e.collection === 'reviews' }]}>
        {kindLabel(e)} · {formatDate(e.data.date, lang)}
      </span>
      <a href={entryUrl(e)}>{e.data.title}</a>
    </li>
  ))}
</ul>

<style>
  .list { list-style: none; padding: 0; margin: 0; }
  li { border-top: 1px solid var(--line); padding: 16px 0; display: flex; flex-direction: column; gap: 2px; }
  li:last-child { border-bottom: 1px solid var(--line); }
  li a { font-family: var(--serif); font-size: 1.2rem; color: var(--text); text-decoration: none; line-height: 1.35; }
  li a:hover { color: var(--accent); }
</style>
