---
import { routes, t } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props { lang: Lang; alternate: string }
const { lang, alternate } = Astro.props;
const r = routes(lang);
---
<header class="wrap wide">
  <a class="name" href={r.home}>
    <picture>
      <source srcset="/logo/marca-cor-fundo-escuro.svg" media="(prefers-color-scheme: dark)" />
      <img src="/logo/marca-cor.svg" alt="" width="58" height="47" />
    </picture>
    Stefano Garzon
  </a>
  <nav>
    <a href={r.reviews}>{t(lang, 'nav.reviews')}</a>
    <a href={r.posts}>{t(lang, 'nav.posts')}</a>
    <a href={r.about}>{t(lang, 'nav.about')}</a>
    <a href={r.search} aria-label={t(lang, 'nav.search')} class="search">
      <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><circle cx="8.5" cy="8.5" r="6" fill="none" stroke="currentColor" stroke-width="2" /><line x1="13" y1="13" x2="18" y2="18" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
    </a>
    <a class="lang" href={alternate} hreflang={lang === 'pt' ? 'en' : 'pt'}>{lang === 'pt' ? 'EN' : 'PT'}</a>
  </nav>
</header>

<style>
  header { border-bottom: 1px solid var(--line); margin-bottom: 8px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px 20px; padding-top: 22px; padding-bottom: 22px; }
  .name :global(img) { display: block; }
  .name { display: flex; gap: 12px; align-items: center; font-family: var(--serif); font-size: 1.3rem; color: var(--text); text-decoration: none; }
  nav { display: flex; gap: 18px; font-size: 0.9rem; }
  nav a { color: var(--muted); text-decoration: none; }
  nav a:hover { color: var(--text); }
  .search { display: flex; align-items: center; }
  .lang { border-left: 1px solid var(--line); padding-left: 18px; }
</style>
