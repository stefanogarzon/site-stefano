---
import Base from '../layouts/Base.astro';
import { otherLang, routes } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import { turnstileSitekey } from '../lib/turnstile';
import { PRIVACIDADE_RASCUNHO } from '../data/science-tutor.mjs';

interface Props { lang: Lang }
const { lang } = Astro.props;
const r = routes(lang);
const sitekey = turnstileSitekey(import.meta.env.PUBLIC_TURNSTILE_SITEKEY);

interface Secao { titulo: string; paragrafos?: string[]; itens?: string[] }

const txt = {
  pt: {
    titulo: 'Aviso de privacidade do Science Tutor',
    description: 'O que o cadastro do Science Tutor guarda, para quê, onde, por quanto tempo e como pedir a exclusão dos seus dados.',
    rascunho: 'RASCUNHO — aguardando aprovação do dono',
    rascunhoTexto: 'Este texto ainda não foi aprovado e pode mudar.',
    voltar: 'Voltar ao Science Tutor',
    secoes: [
      {
        titulo: 'Quem é o responsável',
        paragrafos: ['Stefano Garzon, que distribui o Science Tutor, é o responsável pelos dados do cadastro (controlador, nos termos da LGPD).'],
      },
      {
        titulo: 'O que é guardado',
        itens: [
          'nome, sobrenome e e-mail, como você os digitou no cadastro;',
          'a data do aceite deste aviso;',
          'o hash do token de acesso enviado a você (o token em si não fica guardado);',
          'por 24 h, um HMAC do IP de cada pedido de cadastro ou de exclusão, para limitar o número de pedidos (o IP em si não fica guardado).',
        ],
      },
      {
        titulo: 'Para quê',
        paragrafos: [
          'Os dados servem para enviar o acesso ao app (o link de download e o token) e para ativar e manter válido o seu token. Não são vendidos, cedidos nem usados para publicidade.',
        ],
      },
      {
        titulo: 'Onde',
        paragrafos: [
          'Os dados ficam no servidor de distribuição sarzel.com, hospedado na Cloudflare. A Cloudflare também faz a verificação anti-robô (Turnstile) do formulário. O e-mail com o acesso é enviado pelo Resend, que recebe o seu endereço só para entregar a mensagem.',
        ],
      },
      {
        titulo: 'Por quanto tempo',
        paragrafos: [
          'Enquanto o cadastro existir, até o pedido de exclusão. O HMAC do IP é apagado depois de 24 h.',
        ],
      },
      {
        titulo: 'Como pedir a exclusão',
        paragrafos: [
          'Informe o e-mail do cadastro no formulário abaixo. Você recebe nesse e-mail um link de confirmação, válido por 24 h. Confirmada, a exclusão apaga o seu cadastro e desativa o seu token de acesso.',
        ],
      },
    ] satisfies Secao[],
    excluirTitulo: 'Excluir meus dados',
    email: 'E-mail do cadastro',
    enviar: 'Pedir a exclusão',
    noscript: 'O formulário de exclusão precisa de JavaScript. Ative o JavaScript no navegador para pedir a exclusão.',
    indisponivel: 'Pedido de exclusão indisponível no momento.',
    okTitulo: 'Pedido recebido',
    okTexto: 'Se o e-mail estiver cadastrado, você recebe nele um link para confirmar a exclusão. O link vale por 24 h.',
  },
  en: {
    titulo: 'Science Tutor privacy notice',
    description: 'What the Science Tutor sign-up stores, why, where, for how long and how to ask for your data to be deleted.',
    rascunho: 'DRAFT — awaiting owner approval',
    rascunhoTexto: 'This text has not been approved yet and may change.',
    voltar: 'Back to Science Tutor',
    secoes: [
      {
        titulo: 'Who is responsible',
        paragrafos: ['Stefano Garzon, who distributes Science Tutor, is responsible for the sign-up data (the controller, under Brazil’s LGPD).'],
      },
      {
        titulo: 'What is stored',
        itens: [
          'your first name, last name and email, as you typed them in the sign-up;',
          'the date you accepted this notice;',
          'a hash of the access token sent to you (the token itself is not stored);',
          'for 24 hours, an HMAC of your IP address for each sign-up or deletion request, to limit the number of requests (the IP address itself is not stored).',
        ],
      },
      {
        titulo: 'Why',
        paragrafos: [
          'The data is used to send you access to the app (the download link and the token) and to activate your token and keep it valid. It is not sold, shared or used for advertising.',
        ],
      },
      {
        titulo: 'Where',
        paragrafos: [
          'The data is stored on the sarzel.com distribution server, hosted on Cloudflare. Cloudflare also runs the anti-bot check (Turnstile) on the form. The email with your access is sent through Resend, which receives your address only to deliver the message.',
        ],
      },
      {
        titulo: 'For how long',
        paragrafos: ['As long as the sign-up exists, until your deletion request. The IP HMAC is deleted after 24 hours.'],
      },
      {
        titulo: 'How to ask for deletion',
        paragrafos: [
          'Enter your sign-up email in the form below. You will receive a confirmation link at that address, valid for 24 hours. Once confirmed, the deletion erases your sign-up and deactivates your access token.',
        ],
      },
    ] satisfies Secao[],
    excluirTitulo: 'Delete my data',
    email: 'Sign-up email',
    enviar: 'Request deletion',
    noscript: 'The deletion form needs JavaScript. Enable JavaScript in your browser to request deletion.',
    indisponivel: 'Deletion requests are unavailable at the moment.',
    okTitulo: 'Request received',
    okTexto: 'If the email is registered, you will receive a link at that address to confirm the deletion. The link is valid for 24 hours.',
  },
}[lang];
---
<Base
  title={txt.titulo}
  description={txt.description}
  lang={lang}
  alternate={routes(otherLang(lang)).scienceTutorPrivacy}
  hasTranslation
  noindex={PRIVACIDADE_RASCUNHO}
>
<div class="privacidade">
  {PRIVACIDADE_RASCUNHO && (
    <div class="rascunho" role="note">
      <strong>{txt.rascunho}</strong>
      <span>{txt.rascunhoTexto}</span>
    </div>
  )}
  <p class="eyebrow"><a href={r.scienceTutor}>Science Tutor</a></p>
  <h1>{txt.titulo}</h1>

  {txt.secoes.map((s) => (
    <section>
      <h2>{s.titulo}</h2>
      {s.paragrafos?.map((par) => <p>{par}</p>)}
      {s.itens && <ul>{s.itens.map((item) => <li>{item}</li>)}</ul>}
    </section>
  ))}

  <section class="exclusao" aria-labelledby="exclusao-titulo">
    <h2 id="exclusao-titulo">{txt.excluirTitulo}</h2>
    {sitekey === null ? (
      <p class="aviso" id="exclusao-indisponivel">{txt.indisponivel}</p>
    ) : (
      <Fragment>
        <noscript><p class="aviso">{txt.noscript}</p></noscript>
        <form id="exclusao" novalidate data-lang={lang}>
          <fieldset disabled>
            <div class="campo">
              <label for="exc-email">{txt.email}</label>
              <input id="exc-email" name="email" type="email" maxlength="100" autocomplete="email" inputmode="email" required aria-describedby="erro-exc-email" />
              <p class="erro" id="erro-exc-email" hidden></p>
            </div>
            <div class="campo">
              <div class="cf-turnstile" data-sitekey={sitekey} data-language={lang === 'pt' ? 'pt-br' : 'en'}></div>
              <p class="erro" id="erro-exc-turnstile" hidden></p>
            </div>
            <button type="submit">{txt.enviar}</button>
            <p class="status" id="exclusao-status" role="status" aria-live="polite"></p>
          </fieldset>
        </form>
        <div id="exclusao-ok" class="confirmacao" tabindex="-1" hidden>
          <h3>{txt.okTitulo}</h3>
          <p>{txt.okTexto}</p>
        </div>
        <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
      </Fragment>
    )}
  </section>

  <p><a href={r.scienceTutor}>{txt.voltar}</a></p>
</div>
</Base>

<style>
  .rascunho {
    display: flex; flex-wrap: wrap; gap: 4px 12px; align-items: baseline;
    margin: 0 0 24px; padding: 12px 16px; border: 2px dashed var(--text); border-radius: 8px; background: var(--soft);
  }
  /* --accent on --bg is 3.4:1 in the light theme; link text needs 4.5:1. */
  .privacidade { --accent-texto: color-mix(in srgb, var(--accent) 75%, var(--text)); }
  .privacidade a { color: var(--accent-texto); }
  .exclusao { background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: 8px 24px 24px; margin: 32px 0; }
  .exclusao h2 { margin-top: 0.6em; }
  fieldset { border: 0; margin: 0; padding: 0; min-width: 0; }
  .campo { margin: 0 0 18px; }
  label { display: block; font-size: 0.9rem; font-weight: 500; margin-bottom: 6px; }
  input[type='email'] {
    width: 100%; min-height: 44px; padding: 8px 12px; font: inherit; color: var(--text);
    background: var(--bg); border: 1px solid var(--muted); border-radius: 8px;
  }
  input:focus-visible, button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  button {
    min-height: 44px; padding: 10px 22px; font: inherit; font-weight: 600; border-radius: 8px; cursor: pointer;
    background: var(--text); color: var(--bg); border: 1px solid var(--text);
  }
  button:disabled { opacity: 0.55; cursor: not-allowed; }
  .erro { color: var(--accent-texto); font-size: 0.85rem; margin: 6px 0 0; }
  .aviso { border-left: 3px solid var(--accent); padding: 8px 14px; background: var(--soft); border-radius: 0 8px 8px 0; }
  .confirmacao h3 { margin-top: 0.4em; }
  .confirmacao:focus { outline: none; }
</style>

<script>
  import { ligarExclusao } from '../scripts/exclusao-form';
  import type { TurnstileApi } from '../scripts/cadastro-form';

  ligarExclusao(document, {
    fetch: (...args) => window.fetch(...args),
    turnstile: () => (window as unknown as { turnstile?: TurnstileApi }).turnstile,
  });
</script>
