---
import Shape from './Shape.astro';
import { entryUrl, formatDate, t } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import type { Item } from '../lib/content';

interface Props { items: Item[]; lang: Lang; /** Primeiro item em destaque, maior. */ feature?: boolean }
const { items, lang, feature = false } = Astro.props;
const shapeOf = (e: Item) => (e.collection === 'reviews' ? 'reviews' : e.data.category);
const label = (e: Item) => (e.collection === 'reviews' ? t(lang, 'kind.reviews') : t(lang, `cat.${e.data.category}`));
const [first, ...rest] = items;
---
{items.length === 0 && <p class="muted">{t(lang, 'empty')}</p>}
<div class="cards">
  {items.map((e, i) => {
    const big = feature && e === first;
    return (
      <a href={entryUrl(e)} class:list={['card', { feature: big }]}>
        <span class="bar">
          <span class="kind"><span class="dot" style={`background:var(--c-${shapeOf(e)})`} />{label(e)}</span>
          <span>{formatDate(e.data.date, lang)}</span>
        </span>
        <span class="body">
          <span class="text">
            <span class="title">{e.data.title}</span>
            <span class="desc">{e.data.description}</span>
          </span>
          <Shape shape={shapeOf(e)} width={big ? 200 : 120} class="art" />
        </span>
      </a>
    );
  })}
</div>

<style>
  .cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .card { background: var(--card); border: 1px solid var(--line); border-radius: 14px; overflow: hidden; display: flex; flex-direction: column; color: var(--text); text-decoration: none; transition: border-color 0.15s, transform 0.15s; }
  .card:hover { border-color: var(--muted); transform: translateY(-2px); }
  .card.feature { grid-column: span 2; }
  .bar { display: flex; justify-content: space-between; padding: 11px 18px; border-bottom: 1px solid var(--line); font-size: 0.8rem; color: var(--muted); }
  .kind { display: flex; gap: 8px; align-items: center; color: var(--text); font-weight: 500; }
  .body { display: flex; flex-direction: column-reverse; justify-content: flex-end; gap: 18px; padding: 22px 20px 24px; flex: 1; }
  .feature .body { flex-direction: row; align-items: center; justify-content: space-between; }
  .text { display: flex; flex-direction: column; gap: 8px; }
  .title { font-family: var(--serif); font-size: 1.3rem; line-height: 1.22; font-weight: 500; }
  .feature .title { font-size: clamp(1.6rem, 3vw, 2.1rem); }
  .desc { color: var(--muted); font-size: 0.92rem; line-height: 1.5; }
  .art { flex: none; }
  @media (max-width: 900px) {
    .cards { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 600px) {
    .cards { grid-template-columns: 1fr; }
    .card.feature { grid-column: auto; }
    .feature .body { flex-direction: column-reverse; align-items: flex-start; }
  }
</style>
