---
import Base from '../layouts/Base.astro';
import Cards from './Cards.astro';
import Shape from './Shape.astro';
import { itemsIn } from '../lib/content';
import { categoryUrl, otherLang, routes, t, type Kind } from '../i18n/utils';
import { categories, type Category, type Lang } from '../i18n/ui';
import { repos } from '../data/repos';

interface Props { lang: Lang; kind: Kind; category?: Category }
const { lang, kind, category } = Astro.props;
const items = (await itemsIn(lang)).filter(
  (e) => e.collection === kind && (!category || (e.collection === 'posts' && e.data.category === category)),
);
const title = category ? t(lang, `cat.${category}`) : t(lang, kind === 'reviews' ? 'nav.reviews' : 'nav.posts');
const alternate = category ? categoryUrl(category, otherLang(lang)) : routes(otherLang(lang))[kind];
const shape = kind === 'reviews' ? 'reviews' : category;
---
<Base title={title} description={title} lang={lang} alternate={alternate} hasTranslation wide>
  <div class="head">
    <h1>{title}</h1>
    {shape && <Shape shape={shape} width={140} />}
  </div>
  {kind === 'posts' && (
    <nav class="chips">
      <a href={routes(lang).posts} class:list={['chip', { on: !category }]}>{t(lang, 'all')}</a>
      {categories.map((c) => (
        <a href={categoryUrl(c, lang)} class:list={['chip', { on: c === category }]}>{t(lang, `cat.${c}`)}</a>
      ))}
    </nav>
  )}
  {category === 'computacao' && (
    <section class="repos">
      <h2>{lang === 'pt' ? 'Repositórios no GitHub' : 'GitHub repositories'}</h2>
      <ul>
        {repos.map((r) => <li><a href={r.url}>{r.name}</a> — {r.desc[lang]}</li>)}
      </ul>
    </section>
  )}
  <div class="list"><Cards items={items} lang={lang} /></div>
</Base>

<style>
  .head { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; margin: 40px 0 24px; }
  .head h1 { font-size: clamp(2.4rem, 6vw, 3.6rem); margin: 0; }
  .list { margin-top: 28px; }
  .repos { margin-top: 28px; }
  .repos h2 { font-size: 1.2rem; margin: 0 0 8px; }
  .repos ul { margin: 0; padding-left: 1.2em; }
  .repos li { margin: 4px 0; }
</style>
