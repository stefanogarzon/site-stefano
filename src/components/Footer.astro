---
import { routes } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
---
<footer class="wrap wide">
  <hr />
  <p class="muted">© {new Date().getFullYear()} Stefano Garzon · <a href={routes(lang).rss}>RSS</a></p>
</footer>

<style>
  footer { margin-top: 80px; padding-bottom: 40px; font-size: 0.85rem; }
  footer a { color: var(--muted); }
</style>
